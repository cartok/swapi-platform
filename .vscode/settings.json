{
  "search.exclude": {
    "**/.task": true,
    "**/*.lock": true,
    "**/dist": true,
    "**/node_modules": true
  },
  "files.associations": {
    "*.lock": "plaintext"
  },
  "debug.terminal.clearBeforeReusing": true,
  "css.lint.unknownAtRules": "ignore",
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.preferTypeOnlyAutoImports": false,
  "js/ts.preferGoToSourceDefinition": false,
  "js/ts.suggest.autoImports": true,
  "js/ts.suggest.includeCompletionsForImportStatements": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.rulers": [90],
  "eslint.debug": false,
  "eslint.format.enable": false,
  "eslint.quiet": true,
  "eslint.useFlatConfig": true,
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "never",
      "source.addMissingImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "never",
      "source.addMissingImports": "explicit"
    }
  },
  "[html]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "path-autocomplete.includeExtension": true
  },
  "[css]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "path-autocomplete.includeExtension": true
  },
  "[yml]": {
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "editor.rulers": [100]
  },
  "[yaml]": {
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "editor.rulers": [100]
  },
  "[markdown]": {
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "editor.rulers": [100]
  },
  "[json]": {
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockerfile]": {
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.defaultFormatter": "wharflab.tally",
    "editor.formatOnSave": true,
    "editor.rulers": [100]
  },
  // EXTENSION: wharflab.tally
  "tally.importStrategy": "useBundled",
  // EXTENSION: EditorConfig.EditorConfig
  "files.trimTrailingWhitespace": false,
  // EXTENSION: Tyriar.sort-lines
  "sortLines.filterBlankLines": true,
  // EXTENSION: ionutvmi.path-autocomplete
  "path-autocomplete.enableFolderTrailingSlash": true,
  "path-autocomplete.pathMappings": {
    "/fonts": {
      "conditions": [
        {
          "when": "**/packages/client/**/*.{css,html}",
          "value": "${folder}/packages/client/public/fonts"
        }
      ]
    },
    "@swapi": {
      "conditions": [
        {
          "when": "**/packages/client/**/*.{css,html}",
          "value": "${workspace}/packages"
        }
      ]
    },
    "@/css": {
      "conditions": [
        {
          "when": "**/packages/client/**/*.{css,html}",
          "value": "${workspace}/packages/client/src/css"
        }
      ]
    },
    "@": {
      "conditions": [
        {
          "when": "**/packages/client/**/*.{css,html}",
          "value": "${workspace}/packages/client/src"
        }
      ]
    },
    "./": {
      "conditions": [
        {
          "when": "**/{Dockerfile,*.Dockerfile,Dockerfile.*}",
          "value": "${workspace}"
        }
      ]
    }
  },
  "path-autocomplete.excludedItems": {
    "**/*.map": { "when": "**" },
    "**/{.git,node_modules}": { "when": "**" },
    "**/*.ts": { "when": "**", "context": "import.*" }
  },
  "path-autocomplete.ignoredPrefixes": [
    "=\"/",
    "=\"./",
    "=\"'/",
    "=\"'./",
    "=\"`/",
    "=\"`./",
    "\"",
    "'",
    "`",
    " ",
    "{"
  ],
  "path-autocomplete.triggerOutsideStrings": true,
  // EXTENSION: task.vscode-task
  "taskfile": {
    "path": "bunx --no-install task",
    "tree": {
      "nesting": false
    }
  },
  // EXTENSION: redhat.vscode-yaml and task.vscode-task
  "yaml.schemaStore.enable": true,
  "yaml.keyOrdering": false,
  "yaml.schemas": {
    "https://taskfile.dev/schema.json": ["**/Taskfile.yml", "**/Taskfile.*.yml"],
    "https://json-schema.org/draft/2020-12/schema": [
      "**/*.schema.yml",
      "**/schema.*.yml"
    ],
    "https://www.schemastore.org/fly.json": [
      "**/fly.yaml",
      "**/fly.*.yaml",
      "!**/fly.variables.yaml"
    ]
  },
  // EXTENSION: tamasfe.even-better-toml
  "evenBetterToml.schema.associations": {
    "fly.toml": "https://www.schemastore.org/fly.json",
    "bunfig.toml": "https://www.schemastore.org/bunfig.json"
  }
}
