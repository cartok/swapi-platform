{
  "search.exclude": {
    "**/.task": true,
    "**/*.lock": true,
    "**/dist": true,
    "**/node_modules": true
  },
  "files.associations": {
    "*.lock": "plaintext"
  },
  "editor.wordBasedSuggestions": "matchingDocuments",
  "debug.terminal.clearBeforeReusing": true,
  "css.lint.unknownAtRules": "ignore",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.suggest.autoImports": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.preferTypeOnlyAutoImports": false,
  "js/ts.suggest.includeCompletionsForImportStatements": true,
  "js/ts.updateImportsOnFileMove.enabled": "prompt",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "never",
      "source.addMissingImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "never",
      "source.addMissingImports": "explicit"
    }
  },
  "[html]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "path-autocomplete.includeExtension": true
  },
  "[css]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "path-autocomplete.includeExtension": true
  },
  "[yaml]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100
  },
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // EXTENSION: EditorConfig.EditorConfig
  "files.trimTrailingWhitespace": false,
  // EXTENSION: Tyriar.sort-lines
  "sortLines.filterBlankLines": true,
  // EXTENSION: ionutvmi.path-autocomplete
  "path-autocomplete.enableFolderTrailingSlash": true,
  "path-autocomplete.pathMappings": {
    "/fonts": {
      "conditions": [
        {
          "when": "**/packages/client/**/*.{css,html}",
          "value": "${folder}/packages/client/public/fonts"
        }
      ]
    },
    "@swapi": {
      "conditions": [
        {
          "when": "**/packages/client/**/*.{css,html}",
          "value": "${workspace}/packages"
        }
      ]
    },
    "@/css": {
      "conditions": [
        {
          "when": "**/packages/client/**/*.{css,html}",
          "value": "${workspace}/packages/client/src/css"
        }
      ]
    },
    "@": {
      "conditions": [
        {
          "when": "**/packages/client/**/*.{css,html}",
          "value": "${workspace}/packages/client/src"
        }
      ]
    }
  },
  "path-autocomplete.ignoredPrefixes": [
    "=\"/",
    "=\"./",
    "=\"'/",
    "=\"'./",
    "=\"`/",
    "=\"`./",
    "\"",
    "'",
    "`",
    " ",
    "{"
  ],
  "path-autocomplete.triggerOutsideStrings": true,
  // EXTENSION: redhat.vscode-yaml and task.vscode-task
  "yaml.schemaStore.enable": true,
  "yaml.schemas": {
    "https://taskfile.dev/schema.json": ["**/Taskfile.yml", "**/Taskfile.*.yml"],
    "https://json-schema.org/draft/2020-12/schema": ["**/*.schema.yml", "**/schema.*.yml"]
  },
  // EXTENSION: tamasfe.even-better-toml
  "evenBetterToml.schema.associations": {
    "fly.toml": "https://www.schemastore.org/fly.json"
  }
}
