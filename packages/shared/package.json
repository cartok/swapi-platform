{
  "name": "@swapi/shared",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/*": {
      "types": "./src/*.ts",
      "@swapi/shared/source": "./src/*.ts",
      "@swapi/development": "./dist/development/*.js",
      "@swapi/production": "./dist/production/*.js",
      "default": "./dist/production/*.js"
    }
  },
  "exports": {
    "./generated/*": "./generated/*",
    "./generated/types/*": "./generated/types/*.d.ts",
    "./generated/css/*": "./generated/css/*",
    "./generated/validators/*": {
      "types": "./generated/validators/*.d.ts",
      "default": "./generated/validators/*.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "@swapi/shared/source": "./src/*.ts",
      "@swapi/development": "./dist/development/*.js",
      "@swapi/production": "./dist/production/*.js",
      "default": "./dist/production/*.js"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:validation",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@go-task/cli": "catalog:tooling",
    "ajv": "catalog:validation",
    "bun": "catalog:",
    "quicktype": "catalog:validation",
    "typescript": "catalog:"
  }
}
