{
  "name": "@swapi/hono",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/*": {
      "types": "./src/*.ts",
      "@swapi/hono/source": "./src/*.ts",
      "@swapi/server/source": "./src/*.ts",
      "@swapi/release": "./dist/release/*.js",
      "workerd": "./dist/release/*.js"
    }
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "@swapi/hono/source": "./src/*.ts",
      "@swapi/server/source": "./src/*.ts",
      "@swapi/release": "./dist/release/*.js",
      "workerd": "./dist/release/*.js"
    }
  },
  "dependencies": {
    "@swapi/shared": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@go-task/cli": "catalog:tooling",
    "@swapi/tsconfig": "workspace:*",
    "typescript": "catalog:ts5"
  }
}
