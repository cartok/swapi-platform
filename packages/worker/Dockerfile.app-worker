# syntax=docker/dockerfile:1.23

ARG BUN_VERSION=${BUN_VERSION:-1.3.14}
ARG NODE_VERSION=${NODE_VERSION:-24.16}
ARG DISTRO=debian-trixie
ARG CID_BUN_CACHE=bun
ARG CID_NPM_CACHE=npm

FROM node:${NODE_VERSION}-trixie-slim AS base

WORKDIR /app

ARG BUN_VERSION
ARG CID_NPM_CACHE

ENV DO_NOT_TRACK=1
ENV WRANGLER_SEND_METRICS=false
ENV BUN_FEATURE_FLAG_NO_ORPHANS=1

ENTRYPOINT ["dash"]

SHELL ["/bin/dash", "-euo", "pipefail", "-c"]

RUN --mount=type=cache,target=/root/.npm,id=${CID_NPM_CACHE} <<EOF
npm install --global bun@${BUN_VERSION}
EOF

FROM base AS build-deps

ARG CID_BUN_CACHE

COPY --parents ./.npmrc ./
COPY --parents ./.node-version ./
COPY --parents ./.bun-version ./
COPY --parents ./bun.lock ./
COPY --parents ./package.json ./
COPY --parents ./packages/*/package.json ./

RUN --mount=type=cache,target=/root/.bun/install/cache,id=${CID_BUN_CACHE} <<EOF
bun install --frozen-lockfile --link-native-bins --no-progress --filter=@swapi/worker
EOF

FROM build-deps AS code

COPY --parents ./.npmrc ./
COPY --parents ./.taskrc.yml ./
COPY --parents ./tsconfig.json ./
COPY --parents ./packages/*/tsconfig/*.json ./
COPY --parents ./packages/tsconfig/ ./
COPY --parents ./Taskfile.yml ./
COPY --parents ./Taskfile.*.yml ./
COPY --parents ./packages/*/Taskfile.yml ./
COPY --parents ./packages/*/Taskfile.*.yml ./
COPY --parents ./packages/hono/src/ ./
COPY --parents ./packages/shared/generators/ ./
COPY --parents ./packages/shared/src/ ./
COPY --parents ./packages/worker/wrangler.jsonc ./
COPY --parents ./packages/worker/src/ ./
COPY --parents ./packages/worker/tsconfig/ ./

FROM code AS bundle

ARG TARGET_ENVIRONMENT

RUN <<EOF
bunx --no-install task worker:build:bundle TARGET_ENVIRONMENT=${TARGET_ENVIRONMENT}
EOF

FROM base AS runtime-deps

WORKDIR /app

ARG CID_BUN_CACHE

COPY --parents ./.npmrc ./
COPY --parents ./.node-version ./
COPY --parents ./.bun-version ./
COPY --parents ./bun.lock ./
COPY --parents ./package.json ./
COPY --parents ./packages/*/package.json ./

RUN --mount=type=cache,target=/root/.bun/install/cache,id=${CID_BUN_CACHE} <<EOF
bun install --frozen-lockfile --link-native-bins --no-progress --filter=@swapi/worker --production
ln -s "$(bun pm bin)/wrangler" /usr/local/bin
EOF

FROM runtime-deps AS runtime

WORKDIR /app/dist

COPY --from=code /app/packages/worker/wrangler.jsonc ./
COPY --from=bundle /app/packages/worker/dist/index.js ./

RUN cat <<-EOF >.env
ORIGIN_HOST=app-server
EOF

ENTRYPOINT ["wrangler"]
