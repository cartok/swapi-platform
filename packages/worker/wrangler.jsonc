{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "swapi-platform-device-redirection",
  "main": "src/index.ts",
  "minify": true,
  "compatibility_date": "2026-05-07",
  "env": {
    "local": {
      "vars": {
        "TARGET_ENVIRONMENT": "local",
        "PORT": 52000,
        "ORIGIN_PROTOCOL": "http",
        "ORIGIN_HOST": "localhost",
        "ORIGIN_PORT": 51000,
      },
    },
    "ci": {
      "vars": {
        "TARGET_ENVIRONMENT": "ci",
        "PORT": 52000,
        "ORIGIN_PROTOCOL": "http",
        "ORIGIN_HOST": "app-server",
        "ORIGIN_PORT": 51000,
      },
    },
    "testing": {
      "vars": {
        "TARGET_ENVIRONMENT": "testing",
        "ORIGIN_PROTOCOL": "http",
        "ORIGIN_HOST": "localhost",
        "ORIGIN_PORT": 51000,
      },
      "route": {
        "pattern": "test-swapi-platform.cartok.dev/*",
        "zone_name": "cartok.dev",
      },
    },
    "production": {
      "vars": {
        "TARGET_ENVIRONMENT": "production",
        "ORIGIN_PROTOCOL": "https",
        "ORIGIN_HOST": "swapi-platform.fly.dev",
        "ORIGIN_PORT": "443",
      },
      "route": {
        "pattern": "swapi-platform.cartok.dev/*",
        "zone_name": "cartok.dev",
      },
    },
  },
}
