# syntax=docker/dockerfile:1.23

ARG BUN_VERSION=${BUN_VERSION:-1.3.14}
ARG DOCKER_RUNTIME_IMAGE_VARIANT=distroless
ARG NODE_ENV
ARG SWAPI_BUILD_LEVEL
ARG SWAPI_TARGET_ENVIRONMENT
ARG SWAPI_GIT_COMMIT_SHA
ARG VARIANT_DIR=${SWAPI_TARGET_ENVIRONMENT}/${SWAPI_BUILD_LEVEL}
ARG VARIANT_ENV_FILE=.env.${SWAPI_TARGET_ENVIRONMENT}.${SWAPI_BUILD_LEVEL}
ARG CID_BUN_CACHE=bun

FROM oven/bun:${BUN_VERSION}-slim AS base

ENTRYPOINT ["dash"]

SHELL ["/bin/dash", "-euo", "pipefail", "-c"]

ENV DO_NOT_TRACK=1
ENV BUN_FEATURE_FLAG_NO_ORPHANS=1

WORKDIR /app

FROM base AS deps

ARG CID_BUN_CACHE

COPY --parents ./.npmrc ./
COPY --parents ./.node-version ./
COPY --parents ./.bun-version ./
COPY --parents ./bun.lock ./
COPY --parents ./package.json ./
COPY --parents ./packages/*/package.json ./

RUN --mount=type=cache,target=/root/.bun/install/cache,id=${CID_BUN_CACHE} <<EOF
bun install --frozen-lockfile --link-native-bins --no-progress --filter=@swapi/server
EOF

FROM deps AS code

ARG VARIANT_ENV_FILE
ARG VARIANT_ENV_FILE_DOCKER

COPY --parents ./.taskrc.yml ./
COPY --parents ./packages/tsconfig/ ./
COPY --parents ./packages/*/tsconfig/*.json ./
COPY --parents ./packages/client/public/ ./
COPY --parents ./packages/client/index.html ./
COPY --parents ./packages/client/.env/${VARIANT_ENV_FILE} ./
COPY --parents ./packages/server/.env/${VARIANT_ENV_FILE} ./
COPY --parents ./packages/client/vite.config.ts ./
COPY --parents ./packages/server/rolldown.config.ts ./
COPY --parents ./packages/shared/generators/ ./
COPY --parents ./packages/*/src/ ./
COPY --parents ./Taskfile.yml ./
COPY --parents ./Taskfile.*.yml ./
COPY --parents ./packages/*/Taskfile.yml ./
COPY --parents ./packages/*/Taskfile.*.yml ./

FROM code AS bundle

ARG NODE_ENV
ARG SWAPI_BUILD_LEVEL
ARG SWAPI_GIT_COMMIT_SHA
ARG SWAPI_TARGET_ENVIRONMENT

ENV NODE_ENV=${NODE_ENV}
ENV SWAPI_BUILD_LEVEL=${SWAPI_BUILD_LEVEL}
ENV SWAPI_GIT_COMMIT_SHA=${SWAPI_GIT_COMMIT_SHA}
ENV SWAPI_SOURCE_MODE=dist
ENV SWAPI_TARGET_ENVIRONMENT=${SWAPI_TARGET_ENVIRONMENT}

RUN bunx --no-install task server:build:bundle

FROM oven/bun:${BUN_VERSION}-${DOCKER_RUNTIME_IMAGE_VARIANT} AS runtime

ARG NODE_ENV
ARG SWAPI_BUILD_LEVEL
ARG SWAPI_TARGET_ENVIRONMENT
ARG SWAPI_GIT_COMMIT_SHA
ARG VARIANT_ENV_FILE
ARG VARIANT_DIR

ENV DO_NOT_TRACK=1
ENV BUN_FEATURE_FLAG_NO_ORPHANS=0
ENV NODE_ENV=${NODE_ENV}
ENV SWAPI_BUILD_LEVEL=${SWAPI_BUILD_LEVEL}
ENV SWAPI_GIT_COMMIT_SHA=${SWAPI_GIT_COMMIT_SHA}
ENV SWAPI_TARGET_ENVIRONMENT=${SWAPI_TARGET_ENVIRONMENT}
ENV SWAPI_SERVER_HOST_INTERNAL=0.0.0.0

WORKDIR /app

# Neccessary for SSR-Worker termination, see: https://github.com/oven-sh/bun/issues/31281
COPY --from=deps --parents /usr/lib/x86_64-linux-gnu/libgcc_s.so.1 /

# Copy dependant files:
# - The client's dist-dirs.js has to stay in it's dist dir, must not be bundled and
# the root and client package.json's have to exist aswell to have it resolvable.
# To resolve unbundled monorepo files we also need to copy the symlinks in node_modules.
# - The client's browser build and the SSG files also need to be available for the server
#   runtime.
# - The vite manifests for SSR.
COPY --from=deps --parents /app/package.json /
COPY --from=deps --parents /app/packages/client/package.json /
COPY --from=deps --parents /app/node_modules/@swapi/ /
COPY --from=bundle --parents /app/packages/client/dist/${VARIANT_DIR}/dist-paths.js /
COPY --from=bundle --parents /app/packages/client/dist/${VARIANT_DIR}/browser/ /
COPY --from=bundle --parents /app/packages/client/dist/${VARIANT_DIR}/ssg/ /
COPY --from=bundle --parents /app/packages/client/dist/${VARIANT_DIR}/ssr/.vite/ /

# Copy server files:
# - To start the server we additionally need the server's environment files and the
# server bundle.
# - The variant bundle is copied into a dedicated folder in the working directory, so
# that the entrypoint can be executed in the CMD by exit form, in order to ensure
# correct process signal behavior.
COPY --from=code /app/packages/server/.env/ ./.env/
COPY --from=bundle /app/packages/server/dist/${VARIANT_DIR}/bundle/ ./bundle/

# As this is the distroless bun image, the bun parameters are set by environment variable.
ENV BUN_OPTIONS="\
--conditions @swapi/${VARIANT_DIR} \
--conditions @swapi/${SWAPI_BUILD_LEVEL} \
--env-file ./.env/${VARIANT_ENV_FILE} \
"

# Start the server.
CMD ["./bundle/server.js"]
