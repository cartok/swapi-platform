{
  "extends": [
    "@swapi/tsconfig/tsconfig.base",
    "@swapi/tsconfig/tsconfig.rules",
    "@swapi/tsconfig/tsconfig.node.ts5",
    "@swapi/tsconfig/tsconfig.lib"
  ],
  "compilerOptions": {
    "rootDir": "../src",
    "types": ["node", "bun"]
  },
  // Workaround: The Angular compiler options are already set by @swapi/tsconfig/tsconfig.angular.
  // I've set `strictTemplates` here to get around wrong language service warnings.
  // Don't extend the options here.
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["../src/**/*.ts"]
}
