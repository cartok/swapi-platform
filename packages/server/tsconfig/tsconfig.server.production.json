{
  "extends": [
    "./tsconfig.server.json",
    "@swapi/tsconfig/production",
    "@swapi/tsconfig/production.node"
  ],
  // Workaround: The Angular compiler options are already set by @swapi/tsconfig/angular.
  // I've set `strictTemplates` here to get around wrong language service warnings.
  // Don't extend the options here.
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "references": [{ "path": "../../shared/tsconfig/tsconfig.shared.production.json" }]
}
