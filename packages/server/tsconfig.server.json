{
  "extends": [
    "@swapi/tsconfig/base",
    "@swapi/tsconfig/rules",
    "@swapi/tsconfig/node",
    "@swapi/tsconfig/lib"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist"
  },
  // Workaround: The Angular compiler options are already set by @swapi/tsconfig/angular.
  // I've set `strictTemplates` here to get around wrong language service warnings.
  // Don't extend the options here.
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["./src/**/*.ts"],
  "references": [{ "path": "../shared/tsconfig.shared.json" }]
}
