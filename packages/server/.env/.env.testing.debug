NODE_ENV=development
SWAPI_ALLOWED_HOSTS=swapi-platform.fly.dev,swapi-platform.cartok.dev
SWAPI_BUILD_MINIFY=false
SWAPI_BUILD_SOURCEMAP=external
SWAPI_FLY_CHECK_ALIFE_TIMEOUT=2
SWAPI_FLY_CHECK_ERRORS_TIMEOUT=2
SWAPI_FLY_CHECK_SSR_TIMEOUT=2
SWAPI_FLY_KILL_TIMEOUT=8
SWAPI_FLY_REQUEST_HARD_LIMIT=20
SWAPI_FLY_REQUEST_SOFT_LIMIT=10
SWAPI_FLY_SERVICE_CHECK_READY_TIMEOUT=5
SWAPI_LOG_LEVEL=info
SWAPI_PROFILE=debug
SWAPI_RUN_MODE=build
SWAPI_SERVER_HOST_INTERNAL=0.0.0.0
SWAPI_SERVER_HOST=swapi-platform.fly.dev
SWAPI_SERVER_PORT=51000
SWAPI_TARGET=testing
