BUILD_FLY_CHECK_ALIFE_TIMEOUT=2
BUILD_FLY_CHECK_ERRORS_TIMEOUT=2
BUILD_FLY_CHECK_SSR_TIMEOUT=2
BUILD_FLY_KILL_TIMEOUT=8
BUILD_FLY_REQUEST_HARD_LIMIT=12
BUILD_FLY_REQUEST_SOFT_LIMIT=8
BUILD_FLY_SERVICE_CHECK_READY_TIMEOUT=5
